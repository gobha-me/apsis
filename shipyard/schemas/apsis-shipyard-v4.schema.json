{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobha.me/schemas/apsis-shipyard-v4.schema.json", "title": "Apsis v4 blueprint", "type": "object",
  "properties": {
    "schema": {"const": "apsis-shipyard-v4"}, "name": {"type": "string"}, "buildType": {"enum": ["ship", "station"]},
    "budget": {"type": "integer", "minimum": 0},
    "loads": {
      "type": "object",
      "properties": {
        "cargo": {"type": "number", "minimum": 0, "maximum": 1},
        "jumpFuel": {"type": "number", "minimum": 0, "maximum": 1},
        "sublightFuel": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["cargo", "jumpFuel", "sublightFuel"], "additionalProperties": false
    },
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "floors": {
            "type": "object", "propertyNames": {"pattern": "^(0|[1-9][0-9]*),(0|[1-9][0-9]*)$"},
            "additionalProperties": {"const": true}
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "integer", "minimum": 1},
                "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "x": {"type": "integer", "minimum": 0},
                "y": {"type": "integer", "minimum": 0}, "r": {"type": "integer", "minimum": 0},
                "interface": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
                "craft": {"anyOf": [{"$ref": "#"}, {"type": "null"}]}
              },
              "required": ["id", "type", "x", "y", "r"], "additionalProperties": false
            }
          }
        },
        "required": ["name", "floors", "modules"], "additionalProperties": false
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
          "w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1},
          "firstDeck": {"type": "integer", "minimum": 0}, "lastDeck": {"type": "integer", "minimum": 0}
        },
        "required": ["x", "y", "w", "h", "firstDeck", "lastDeck"], "additionalProperties": false
      }
    },
    "nextId": {"type": "integer", "minimum": 1}, "migrationNotes": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema", "name", "buildType", "budget", "loads", "decks", "nextId", "migrationNotes"],
  "additionalProperties": false
}
