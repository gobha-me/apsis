{
  "schema": "apsis-ship-rules-v4",
  "version": 4,
  "notes": "Engineering and economy rules shared by shipyard definitions. Technical limits are input sanity limits only; maxBudgetInputCr is not a game budget or player-affordability rule. The shipyard does not enforce player affordability. F11-F17, F19, F20, and F21 hangar alignment remain open for Luna. Hold behavior, hangar docking rotations and alignment, and undefined performance results remain unspecified.",
  "floorMass": 0.15,
  "floorCost": 40,
  "cellSizeM": 2,
  "massReference": 100,
  "floor": {
    "id": "floor",
    "name": "Hull floor",
    "description": "One 2 m × 2 m structural floor section.",
    "category": "Structure",
    "uiCategory": "structure",
    "w": 1,
    "h": 1,
    "cost": 40,
    "mass": 0.15,
    "space": 0,
    "color": "#8b9fac",
    "power": 0,
    "walkable": true,
    "cellSizeM": 2
  },
  "grid": {
    "w": 26,
    "h": 24
  },
  "limits": {
    "minDecks": 1,
    "maxDecks": 5,
    "maxCarryDepth": 1,
    "maxModuleId": 1000000000,
    "maxDeckName": 48,
    "maxTemplateName": 48,
    "maxMigrationNotes": 32,
    "maxNoteLength": 300
  },
  "defaults": {
    "buildType": "ship",
    "budget": 100000,
    "loads": {
      "cargo": 0,
      "jumpFuel": 1,
      "sublightFuel": 1
    },
    "shipName": "Untitled vessel",
    "stationName": "Untitled station",
    "deckName": "Main deck",
    "templateAlias": {
      "starter": "flat"
    },
    "defaultCraft": "skiff"
  },
  "numeric": {
    "precision": 6,
    "epsilon": 1e-06
  },
  "rotations": [
    {
      "dx": 0,
      "dy": 1
    },
    {
      "dx": -1,
      "dy": 0
    },
    {
      "dx": 0,
      "dy": -1
    },
    {
      "dx": 1,
      "dy": 0
    }
  ],
  "docking": {
    "interfaces": [
      "standard",
      "cargo"
    ],
    "defaultInterface": "standard",
    "targetKinds": [
      "port",
      "hangar"
    ],
    "alignment": {
      "targetKind": "port",
      "sameDeck": true,
      "referencePoint": "centres",
      "distanceMetric": "manhattan",
      "singleAxis": true,
      "maxDistanceCells": 1
    }
  },
  "performance": {
    "massReference": 100,
    "cargoMassPerUnit": 1,
    "jumpFuelMassPerCharge": 0.25,
    "jumpFuelPerJump": 1,
    "baseLifeSupportDays": 60,
    "suitReserveDays": 10,
    "reserveLifeSupportDays": 30,
    "scenarioFractions": {
      "empty": 0,
      "half": 0.5,
      "full": 1
    },
    "accelerationBands": [
      {
        "min": 0,
        "label": "sluggish"
      },
      {
        "min": 0.25,
        "label": "normal"
      },
      {
        "min": 3,
        "label": "hot"
      }
    ],
    "underpoweredAcceleration": 0.25,
    "advisoryShieldCount": 3,
    "advisoryWeaponCount": 3,
    "units": {
      "mass": "tonnes",
      "thrust": "kN",
      "acceleration": "m/s²",
      "sublightFuel": "tonnes",
      "burnRate": "tonnes/s",
      "deltaV": "m/s",
      "jumpFuel": "charges",
      "power": "power units"
    }
  },
  "validation": {
    "requiredSystems": {
      "ship": [
        "bridge",
        "reactor",
        "lifeSupport",
        "engine"
      ],
      "station": [
        "bridge",
        "reactor",
        "lifeSupport"
      ]
    },
    "requiredAirlock": {
      "ship": true,
      "station": true
    },
    "uniqueSystems": [
      "bridge",
      "lifeSupport",
      "jumpDrive"
    ],
    "fundingDefault": false,
    "checks": {
      "required_system": {
        "severity": "error"
      },
      "command_access": {
        "severity": "error"
      },
      "missing_airlock": {
        "severity": "error"
      },
      "blocked_approach": {
        "severity": "error"
      },
      "unreachable_component": {
        "severity": "error"
      },
      "disconnected_hull": {
        "severity": "error"
      },
      "budget": {
        "severity": "error"
      },
      "power_shortfall": {
        "severity": "warning"
      },
      "weak_acceleration": {
        "severity": "warning"
      },
      "no_sublight_fuel": {
        "severity": "warning"
      },
      "no_jump_fuel": {
        "severity": "warning"
      },
      "unpaired_ladder": {
        "severity": "warning"
      },
      "carried_not_ready": {
        "severity": "warning"
      },
      "excess_defence": {
        "severity": "warning"
      },
      "station_propulsion": {
        "severity": "warning"
      },
      "migration": {
        "severity": "warning"
      },
      "docking": {
        "severity": "error"
      },
      "invalid_blueprint": {
        "severity": "error"
      },
      "many_engines": {
        "severity": "warning"
      },
      "large_fuel_capacity": {
        "severity": "warning"
      },
      "no_cargo": {
        "severity": "warning"
      }
    },
    "defaultSeverity": "error"
  },
  "formulas": {
    "structureMass": [
      "mul",
      "floorCount",
      "floorMass"
    ],
    "dryMass": [
      "add",
      "structureMass",
      "componentMass"
    ],
    "cargoMass": [
      "mul",
      "cargoUnits",
      "cargoMassPerUnit"
    ],
    "jumpFuelMass": [
      "mul",
      "jumpFuelCharges",
      "jumpFuelMassPerCharge"
    ],
    "loadedMass": [
      "add",
      "dryMass",
      "cargoMass",
      "jumpFuelMass",
      "sublightFuelMass",
      "carriedLoadMass"
    ],
    "acceleration": [
      "div",
      "thrust",
      "mass"
    ],
    "range": [
      "div",
      [
        "mul",
        "rating",
        "massReference"
      ],
      "mass"
    ],
    "burnSeconds": [
      "div",
      "fuel",
      "burnRate"
    ],
    "exhaustVelocity": [
      "div",
      "thrust",
      "burnRate"
    ],
    "deltaV": [
      "mul",
      "exhaustVelocity",
      [
        "ln",
        [
          "div",
          "startMass",
          "endMass"
        ]
      ]
    ],
    "jumpCount": [
      "floor",
      [
        "div",
        "fuel",
        "fuelPerJump"
      ]
    ],
    "endurance": [
      "add",
      "baseDays",
      "suitDays",
      [
        "mul",
        "reserves",
        "reserveDays"
      ]
    ],
    "weaponDps": [
      "div",
      "damage",
      "cooldown"
    ],
    "fuelCapacityMass": [
      "add",
      "sublightCapacity",
      [
        "mul",
        "jumpCapacity",
        "jumpFuelMassPerCharge"
      ]
    ],
    "fuelToDryMassRatio": [
      "div",
      "fuelMass",
      "dryMass"
    ]
  },
