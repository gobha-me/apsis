        "cargoMassPerUnit"
      ],
      "jumpFuelMass": [
        "mul",
        "jumpFuelCharges",
        "jumpFuelMassPerCharge"
      ],
      "loadedMass": [
        "add",
        "dryMass",
        "cargoMass",
        "jumpFuelMass",
