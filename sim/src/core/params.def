// The single table of rule switches and placeholders (spec section P). Every number is vetoable.
// The C++ structs, the README table and the report table are all generated from this file.
// RULE(name, default, layer, meaning)
RULE(jumps,     1, 3, "Jumps measured in J (B1); off = the v0.20 hop model (off not built yet: layer 3 has only the J model)")
RULE(hulls,     1, 3, "Ships as mass and space (B2); off = fixed v0.20 upgrades (off not built yet)")
RULE(rescue,    1, 3, "Priced rescue with debt (B6); off = the v0.20 flat tow")
RULE(pockets,   1, 5, "Deep frontier pockets (A12)")
RULE(farpay,    1, 5, "Far pay in the pockets only (A12)")
RULE(shields,   1, 3, "Shields cut misjump and hazard damage (B2)")
RULE(weapons,   1, 3, "Weapons add to the resist roll vs pirates and rogue bodies (B2)")
RULE(lifesupport, 1, 4, "Life support is a system with days and health; a rescue that comes too late is death (owner, 2026-11-20); off = the wait is always survivable (B6 as written)")
RULE(hazdeath,  1, 4, "A bad landing can be fatal (small chance, shields cut it)")
RULE(bankrupt,  1, 4, "Ten years of continuous debt is bankruptcy: the career ends (owner, 2026-11-20)")
RULE(interest,  1, 4, "Logs read by interest (B3); off = every departure stands")
RULE(meet,      1, 4, "Rendezvous jobs (B3)")
RULE(law,       1, 4, "Heat, warrants, charges, exile, scans (spec A law, C4); off = no law")
RULE(pirates,   1, 4, "Pirates attack pilots on arrival (resist roll, weapons help)")
RULE(stack,     1, 5, "Stacked jobs (B4); off = one job at a time")
RULE(cover,     1, 5, "A legal haul on the route is cover (B4)")
RULE(intents,   1, 2, "Faction intents and one clearing step (B5); off = the v0.20 faction cycle")
// PARAM(name, default, unit, meaning, from)
